# Production / Development Server Port (Render injects PORT automatically)
PORT=5000

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# MongoDB Connection String (e.g. mongodb+srv://<user>:<password>@cluster.mongodb.net/syncbooth?retryWrites=true&w=majority)
MONGODB_URI=

# Secret key used for signing JWT tokens
JWT_SECRET=your_jwt_secret_key_change_in_production

# Frontend Client Origin URL (e.g. https://sync-booth.vercel.app or http://localhost:5173)
CLIENT_URL=http://localhost:5173
